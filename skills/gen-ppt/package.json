    "test:native-charts": "node ./scripts/smoke-test-native-charts.mjs"
  },
  "dependencies": {
    "highlight.js": "*",
    "marked": "*",
    "jszip": "3.10.1",
    "pptxgenjs": "4.0.1",
    "saxes": "6.0.0"
  }
}
