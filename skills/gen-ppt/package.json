{
  "name": "gen-ppt",
  "license": "GPL-3.0",
  "version": "2.4.3",
  "private": true,
  "type": "module",
  "description": "Generate validated editable PPTX presentations from JSON or HTML slides from Markdown",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
